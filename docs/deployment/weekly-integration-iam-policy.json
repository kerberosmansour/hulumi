{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRoleTags",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PulumiStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketEncryption",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketVersioning",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:PutBucketEncryption",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::hulumi-*<SANDBOX_ACCOUNT_ID>",
        "arn:aws:s3:::hulumi-*<SANDBOX_ACCOUNT_ID>/*",
        "arn:aws:s3:::af-e2e-*",
        "arn:aws:s3:::af-e2e-*/*"
      ]
    },
    {
      "Sid": "HulumiManagedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetBucket*",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:PutBucket*",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutObject",
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:PutPublicAccessBlock"
      ],
      "Resource": ["arn:aws:s3:::hulumi-*", "arn:aws:s3:::hulumi-*/*"]
    },
    {
      "Sid": "AccountFoundationServices",
      "Effect": "Allow",
      "Action": [
        "access-analyzer:CreateAnalyzer",
        "access-analyzer:DeleteAnalyzer",
        "access-analyzer:GetAnalyzer",
        "access-analyzer:ListAnalyzers",
        "access-analyzer:TagResource",
        "access-analyzer:UntagResource",
        "cloudtrail:AddTags",
        "cloudtrail:CreateTrail",
        "cloudtrail:DeleteTrail",
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetEventDataStore",
        "cloudtrail:GetEventSelectors",
        "cloudtrail:GetTrail",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:ListEventDataStores",
        "cloudtrail:ListTags",
        "cloudtrail:PutEventSelectors",
        "cloudtrail:RemoveTags",
        "cloudtrail:StartLogging",
        "cloudtrail:StopLogging",
        "cloudtrail:UpdateTrail",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:PutMetricAlarm",
        "config:DeleteConfigurationAggregator",
        "config:DeleteConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "config:DescribeConfigurationAggregators",
        "config:DescribeConfigurationRecorderStatus",
        "config:DescribeConfigurationRecorders",
        "config:DescribeDeliveryChannels",
        "config:PutConfigurationAggregator",
        "config:PutConfigurationRecorder",
        "config:PutDeliveryChannel",
        "config:StartConfigurationRecorder",
        "config:StopConfigurationRecorder",
        "guardduty:CreateDetector",
        "guardduty:DeleteDetector",
        "guardduty:GetDetector",
        "guardduty:GetDetectorFeature",
        "guardduty:ListDetectors",
        "guardduty:ListTagsForResource",
        "guardduty:TagResource",
        "guardduty:UntagResource",
        "guardduty:UpdateDetector",
        "guardduty:UpdateDetectorFeature",
        "securityhub:BatchDisableStandards",
        "securityhub:BatchEnableStandards",
        "securityhub:DescribeHub",
        "securityhub:DisableSecurityHub",
        "securityhub:EnableSecurityHub",
        "securityhub:GetEnabledStandards",
        "securityhub:ListTagsForResource",
        "securityhub:TagResource",
        "securityhub:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsForCloudTrail",
      "Effect": "Allow",
      "Action": [
        "logs:AssociateKmsKey",
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DescribeLogGroups",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:*:<SANDBOX_ACCOUNT_ID>:log-group:/aws/hulumi/*"
    },
    {
      "Sid": "KmsForHulumiManagedKeys",
      "Effect": "Allow",
      "Action": [
        "kms:CancelKeyDeletion",
        "kms:CreateAlias",
        "kms:CreateKey",
        "kms:DeleteAlias",
        "kms:DescribeKey",
        "kms:DisableKey",
        "kms:EnableKeyRotation",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListAliases",
        "kms:ListResourceTags",
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:UpdateAlias"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamAccountBaseline",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole",
        "iam:DeleteAccountPasswordPolicy",
        "iam:GetAccountPasswordPolicy",
        "iam:UpdateAccountPasswordPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfigRecorderRoleLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::<SANDBOX_ACCOUNT_ID>:role/af-e2e-*"
    },
    {
      "Sid": "ConfigRecorderManagedPolicyRead",
      "Effect": "Allow",
      "Action": ["iam:GetPolicy", "iam:GetPolicyVersion"],
      "Resource": "arn:aws:iam::aws:policy/service-role/AWS_ConfigRole"
    },
    {
      "Sid": "ConfigRecorderManagedPolicyAttachment",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::<SANDBOX_ACCOUNT_ID>:role/af-e2e-*",
      "Condition": {
        "StringEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWS_ConfigRole"
        }
      }
    },
    {
      "Sid": "ConfigRecorderPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<SANDBOX_ACCOUNT_ID>:role/af-e2e-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "config.amazonaws.com"
        }
      }
    },
    {
      "Sid": "EksQualificationReadinessAndEvidence",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "cloudtrail:LookupEvents",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "cloudwatch:ListTagsForResource",
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeAddresses",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRegions",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVpcs",
        "eks:DescribeAddon",
        "eks:DescribeCluster",
        "eks:DescribeNodegroup",
        "eks:DescribePodIdentityAssociation",
        "eks:DescribeUpdate",
        "eks:ListAddons",
        "eks:ListClusters",
        "eks:ListNodegroups",
        "eks:ListPodIdentityAssociations",
        "eks:ListUpdates",
        "iam:GetInstanceProfile",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:ListRoles",
        "iam:SimulatePrincipalPolicy",
        "sns:GetTopicAttributes",
        "sns:ListTagsForResource",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EksQualificationNetworkCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateInternetGateway",
        "ec2:CreateLaunchTemplate",
        "ec2:CreateRouteTable",
        "ec2:CreateSubnet",
        "ec2:CreateTags",
        "ec2:CreateVpc"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/hulumi:qualification-id": "hulumi-nlr-*"
        },
        "StringEquals": {
          "aws:RequestedRegion": "<SANDBOX_REGION>"
        }
      }
    },
    {
      "Sid": "EksQualificationNetworkMutateTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:CreateRoute",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "ec2:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        },
        "StringEquals": {
          "aws:RequestedRegion": "<SANDBOX_REGION>"
        }
      }
    },
    {
      "Sid": "EksQualificationNetworkDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteInternetGateway",
        "ec2:DeleteLaunchTemplate",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "ec2:DetachInternetGateway",
        "ec2:DisassociateRouteTable"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "ec2:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        },
        "StringEquals": {
          "aws:RequestedRegion": "<SANDBOX_REGION>"
        }
      }
    },
    {
      "Sid": "EksQualificationClusterCreate",
      "Effect": "Allow",
      "Action": [
        "eks:CreateAddon",
        "eks:CreateCluster",
        "eks:CreateNodegroup",
        "eks:CreatePodIdentityAssociation"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationClusterManageTagged",
      "Effect": "Allow",
      "Action": [
        "eks:DeleteAddon",
        "eks:DeleteCluster",
        "eks:DeleteNodegroup",
        "eks:DeletePodIdentityAssociation",
        "eks:TagResource",
        "eks:UntagResource",
        "eks:UpdateNodegroupConfig",
        "eks:UpdateNodegroupVersion"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationIamRoleCreate",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationIamRoleManageTagged",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "iam:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationPassExactRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "eks.amazonaws.com",
            "ec2.amazonaws.com",
            "pods.eks.amazonaws.com"
          ]
        },
        "StringLike": {
          "iam:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationManagedPolicyAttachments",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy",
            "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy",
            "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryPullOnly",
            "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy"
          ]
        },
        "StringLike": {
          "iam:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationMetricsAndAlarmCreate",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricAlarm",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationMetricsAndAlarmDelete",
      "Effect": "Allow",
      "Action": "cloudwatch:DeleteAlarms",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationSnsTopicCreate",
      "Effect": "Allow",
      "Action": "sns:CreateTopic",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    },
    {
      "Sid": "EksQualificationSnsTopicManageTagged",
      "Effect": "Allow",
      "Action": [
        "sns:DeleteTopic",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/hulumi:qualification-id": "hulumi-nlr-*"
        }
      }
    }
  ]
}
