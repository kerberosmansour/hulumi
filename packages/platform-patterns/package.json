{
  "name": "@hulumi/platform-patterns",
  "version": "3.0.0",
  "description": "Cross-provider Pulumi patterns for Cloudflare edge ingress, AWS deployment identity, secure Pulumi state backends, GitHub deployment repositories, build provenance, and runner governance.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerberosmansour/hulumi.git",
    "directory": "packages/platform-patterns"
  },
  "bugs": {
    "url": "https://github.com/kerberosmansour/hulumi/issues"
  },
  "homepage": "https://github.com/kerberosmansour/hulumi/tree/main/packages/platform-patterns#readme",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hulumi/baseline": "workspace:*"
  },
  "peerDependencies": {
    "@pulumi/aws": "^7.50.0",
    "@pulumi/cloudflare": "^6.22.0",
    "@pulumi/github": "^6.15.0",
    "@pulumi/kubernetes": "^4.34.2",
    "@pulumi/pulumi": "^3.268.0"
  },
  "devDependencies": {
    "@pulumi/aws": "7.51.1",
    "@pulumi/cloudflare": "6.22.1",
    "@pulumi/github": "6.15.0",
    "@pulumi/kubernetes": "4.34.2",
    "@pulumi/pulumi": "3.270.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
